# Node modules
node_modules/
**/node_modules/

# Build artifacts
**/dist/

# Logs
backend/logs/
*.log

# Environment files
.env*
!.env.example
!.env.production

# OS-specific files
.DS_Store

# IDE-specific files
.idea/
.vscode/

# Electron build output
dist-electron/
build-resources/

# Symlinks / npm workspace artifacts
frontend@*
scicp@*
npm
vite

# Scraper caches
resources/db/*_cache.json
release.keystore

# Fine-tuned model (large binary files — store in Drive or object storage)
resources/models/
# Generated training data (regenerate with: node scripts/export-training-pairs.js)
resources/training-pairs.json
# Strong's semantic expansion pairs (regenerate with: node scripts/build-strongs-pairs.js)
resources/strongs-pairs.json
# Raw CSV caches (auto-downloaded by build scripts, large)
resources/db/ylt-raw.csv
resources/db/rotherham-raw.csv

# Runtime user data (created by backend at startup)
resources/db/user-data.db

# Runtime prebake artifact (regenerate with: node scripts/prebake-search-graph.js)
resources/db/search-graph.db

# Electron pre-build dep staging
electron/backend-deps/
