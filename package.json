{
  "name": "scicp",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "version": "1.0.0",
  "description": "A high-performance, web-based scripture projection engine.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev --workspace=backend  && npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm start --workspace=backend",
    "test:backend": "npm test --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "check:prod": "npm run build && npm run test:backend && npm run lint:frontend",
    "electron:dev": "npm run build --workspace=frontend && electron .",
    "electron:build": "npm run build --workspace=frontend && electron-builder",
    "electron:build:win": "npm run build --workspace=frontend && electron-builder --win",
    "electron:build:mac": "npm run build --workspace=frontend && electron-builder --mac",
    "electron:build:linux": "npm run build --workspace=frontend && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
